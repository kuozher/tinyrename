{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TinyRename",
  "version": "0.1.0",
  "identifier": "com.tinyrename.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TinyRename",
        "width": 640,
        "height": 640,
        "minWidth": 600,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh",
        "languages": ["TradChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
